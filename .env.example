# Authplane configuration for the streamable-HTTP transport (src/index_http.ts).
# Copy to .env and adjust. Only the HTTP transport is protected; the stdio
# entrypoint (src/index.ts) is unchanged, since it has no network edge.
#
# The project has no dotenv dependency and this integration did not add one,
# so export these into the environment before starting the server:
#   set -a && . ./.env && set +a && ./start_streamable

# Where the Authplane SDK discovers AS metadata and fetches JWKS.
# Must resolve to the SAME host the AS announces in AUTHPLANE_SERVER_ISSUER,
# or every call fails 401 with an opaque invalid_token.
# AS in a container + this server on the host -> http://localhost:9000
# Both on one Docker network                  -> http://authserver:9000
AUTHPLANE_ISSUER=http://localhost:9000

# The canonical Resource URI. This becomes the required JWT `aud` claim and
# must match byte-for-byte in three places: here, the `uri` field of
# POST /admin/resources, and the `resource=` parameter on POST /oauth/token.
# If you change PORT, change this too.
AUTHPLANE_RESOURCE=http://localhost:8976/mcp

# Port the MCP server binds. Kept at the project default; see AUTHPLANE_RESOURCE.
PORT=8976
